def main_menu():
    markup = telebot.types.ReplyKeyboardMarkup(resize_keyboard=True)
    markup.add("📲 إنشاء رقم وهمي", "🔑 طلب رمز التحقق")
    return markup

@bot.message_handler(func=lambda message: message.text == "📲 إنشاء رقم وهمي")
def send_fake_number(message):
    phone_number = generate_fake_number()
    users[message.chat.id] = {"number": phone_number, "code": None}
    bot.send_message(message.chat.id, f"📞 *تم إنشاء رقم وهمي :*\n`{phone_number}`", parse_mode="Markdown")

@bot.message_handler(func=lambda message: message.text == "🔑 طلب رمز التحقق")
def send_verification_code(message):
    if message.chat.id not in users or users[message.chat.id]["number"] is None:
        bot.send_message(message.chat.id, "❌ لم تقم بطلب اي كود حتى الان !", parse_mode="Markdown")
        return

    msg = bot.send_message(message.chat.id, "🔄 *تحديث* ♻️")
    time.sleep(1)

    for dots in [" •", " ••••••••", " ••••••••••••"]:
        bot.edit_message_text(f"🔄 *تحديث* ♻️{dots}", chat_id=message.chat.id, message_id=msg.message_id, parse_mode="Markdown")
        time.sleep(1)

    verification_code = generate_verification_code()
    users[message.chat.id]["code"] = verification_code
    bot.edit_message_text(f"✅ *رمز التحقق هو:*\n`{verification_code}`", chat_id=message.chat.id, message_id=msg.message_id, parse_mode="Markdown")

bot.polling()
