TOKEN = "7213949566:AAFtBLBZC3yCWNkV6StFTBA5MKJkZGRv4FY"  # ضع توكن البوت هنا
bot = telebot.TeleBot(TOKEN)

users = {}

# دالة توليد رقم وهمي (كمثال)
def generate_fake_number():
    return "+1" + "".join(str(random.randint(0, 9)) for _ in range(10))

# دالة توليد رمز تحقق عشوائي
def generate_verification_code():
    return "".join(str(random.randint(0, 9)) for _ in range(6))

@bot.message_handler(commands=["start"])
def send_welcome(message):
    welcome_text = """✨ *مرحبًا بك في بوت الأرقام الوهمية!* 📲

أنا هنا لمساعدتك في **إنشاء أرقام وهمية** و **استخراج رموز التحقق** بسهولة ✅

